<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/studybuddy_bubble_panel_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/widget_on_surface"
        android:text="@string/bubble_panel_title" />

    <TextView
        android:id="@+id/studybuddy_bubble_quick_five"
        style="@style/StudyBuddyBubbleChoice"
        android:layout_marginTop="12dp"
        android:text="@string/bubble_quick_five" />

    <TextView
        android:id="@+id/studybuddy_bubble_quick_twenty_five"
        style="@style/StudyBuddyBubbleChoice"
        android:layout_marginTop="8dp"
        android:text="@string/bubble_quick_twenty_five" />

    <TextView
        android:id="@+id/studybuddy_bubble_dismiss"
        style="@style/StudyBuddyBubbleChoice"
        android:layout_marginTop="8dp"
        android:text="@string/bubble_dismiss" />
</LinearLayout>
