<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|start"
    android:padding="14dp"
    android:background="@drawable/studybuddy_widget_background">

    <TextView
        android:id="@+id/studybuddy_widget_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/widget_on_surface_variant" />

    <TextView
        android:id="@+id/studybuddy_widget_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/widget_on_surface" />

    <TextView
        android:id="@+id/studybuddy_widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_on_surface_variant" />

    <TextView
        android:id="@+id/studybuddy_widget_detail_two"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_on_surface_variant" />

    <TextView
        android:id="@+id/studybuddy_widget_detail_three"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_on_surface_variant" />
</LinearLayout>
